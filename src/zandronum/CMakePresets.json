{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "web",
      "displayName": "Browser: Emscripten, the backend on WebGPU, offline",
      "description": "web_compile.sh's build: no desktop GL, no native-only libraries, no accounts or voice chat. Needs EMSDK and IMPORT_EXECUTABLES (a native build's host tools).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "NO_GL": "ON",
        "NO_GTK": "ON",
        "NO_FMOD": "ON",
        "NO_ASM": "ON",
        "NO_REPLAY": "ON",
        "FUA_DILIGENT": "ON",
        "FUA_WEBGPU": "ON",
        "FUA_MCP_BRIDGE": "OFF",
        "ZX_ENABLE_SENTRY": "OFF",
        "ZX_VOIP": "OFF",
        "ZX_ACCOUNTS": "OFF",
        "FORCE_INTERNAL_ZLIB": "ON",
        "FORCE_INTERNAL_JPEG": "ON",
        "FORCE_INTERNAL_BZIP2": "ON",
        "FORCE_INTERNAL_GME": "ON",
        "DYN_FLUIDSYNTH": "ON"
      }
    }
  ]
}
