// [rc4l] Master E2E control channel for features/quake-movement. See MASTERTEST.md.
//
// Everything here runs SERVER-side. Scripts marked `net` are pukeable, so a connected client can
// ask the server to run them ("puke 10 1"), which is the only way to reach APROP_MvType --
// there is no console command for an actor property.
#library "MVMSTR"
#include "zcommon.acs"

// [rc4l] Not in zcommon.acs: this APROP is added by features/quake-movement (p_acs.h).
#define APROP_MvType 52

// [rc4l] Deliberately does NOT start a perpetual plat on the +ELEVATORJUMP platform. Tried that
// first: the plat immediately snaps the sector to the only neighbouring floor it can find and then
// wedges, and because the stalled thinker stays attached every later Floor_*/Plat_* on that tag is
// silently refused. The platform is driven on demand by script 23 instead.
script 1 OPEN
{
	Log(s:"MVACS open");
}

// Tag each player's pawn so ACS can address it; dumpactor p<N> is the primary readback, this is
// the belt-and-braces path for anything that needs a TID.
script 2 (void) net
{
	Thing_ChangeTID(0, 900 + PlayerNumber());
	Log(s:"MVACS tid player ", d:PlayerNumber(), s:" tid ", d:900 + PlayerNumber());
}

// APROP_MvType, set. Range-checked on both ends -- an out-of-range value must be refused, not
// silently put local prediction on a movement model that does not exist.
script 10 (int mvtype) net
{
	SetActorProperty(0, APROP_MvType, mvtype);
	Log(s:"MVACS setmvtype asked ", d:mvtype, s:" readback ", d:GetActorProperty(0, APROP_MvType));
}

// APROP_MvType, get + CheckActorProperty (a separate code path from the getter).
script 11 (void) net
{
	Log(s:"MVACS getmvtype ", d:GetActorProperty(0, APROP_MvType),
		s:" is0 ", d:CheckActorProperty(0, APROP_MvType, 0),
		s:" is1 ", d:CheckActorProperty(0, APROP_MvType, 1));
}

// Position the activator exactly, in three dimensions. `warp` is 2D and snaps to the floor.
script 12 (int x, int y, int z) net
{
	SetActorPosition(0, x * 65536, y * 65536, z * 65536, 0);
	Log(s:"MVACS pos ", d:x, s:" ", d:y, s:" ", d:z);
}

// A per-tic, SERVER-side trace of the activator. This is the measuring instrument for everything
// timed: apex height, the velocity curve of a jump, terminal speed, distance per tic. It exists
// because an MCP round trip is tens of tics wide, so nothing tic-exact can be sampled by polling
// from outside the engine -- the sampler has to live on the authoritative side of the wire.
// Values are thousandths.
//
// Milli() splits the fixed value rather than multiplying it: a map coordinate is up to 5120.0,
// which is 335544320 raw, and any single multiply by 1000 -- FixedMul included -- overflows the
// 32-bit result and returns noise that still LOOKS like a coordinate. Splitting keeps both halves
// well inside range.
function int Milli(int v)
{
	if (v < 0)
		return -Milli(-v);
	return (v >> 16) * 1000 + (((v & 0xFFFF) * 1000) >> 16);
}

script 20 (int tics, int tag) net
{
	int i;
	for (i = 0; i <= tics; i++)
	{
		Log(s:"MVTRACE ", d:tag, s:" t ", d:i,
			s:" x ", d:Milli(GetActorX(0)),
			s:" y ", d:Milli(GetActorY(0)),
			s:" z ", d:Milli(GetActorZ(0)),
			s:" vx ", d:Milli(GetActorVelX(0)),
			s:" vy ", d:Milli(GetActorVelY(0)),
			s:" vz ", d:Milli(GetActorVelZ(0)));
		Delay(1);
	}
	Log(s:"MVTRACE ", d:tag, s:" end");
}

// mvFlags read back through a path that is NOT dumpactor, so the two can disagree. CheckFlag goes
// through the same DECORATE flag table a mod would use.
script 21 (void) net
{
	Log(s:"MVFLAGS cpm ", d:CheckFlag(0, "CPMAIRCONTROL"),
		s:" slide ", d:CheckFlag(0, "CROUCHSLIDE"),
		s:" wj ", d:CheckFlag(0, "WALLJUMP"),
		s:" wj2 ", d:CheckFlag(0, "WALLJUMPV2"),
		s:" tap ", d:CheckFlag(0, "DOUBLETAPJUMP"),
		s:" climb ", d:CheckFlag(0, "WALLCLIMB"),
		s:" edge ", d:CheckFlag(0, "EDGEJUMP"));
	Log(s:"MVFLAGS silent ", d:CheckFlag(0, "SILENT"),
		s:" elev ", d:CheckFlag(0, "ELEVATORJUMP"),
		s:" awr ", d:CheckFlag(0, "AIRWALLRUN"),
		s:" user4 ", d:CheckFlag(0, "USER4JUMP"),
		s:" gsj ", d:CheckFlag(0, "GROUNDSECONDJUMP"),
		s:" abs ", d:CheckFlag(0, "ABSOLUTESECONDJUMP"));
}

// Where the +ELEVATORJUMP platform is right now, so a jump can be aimed at its rising phase.
script 22 (void) net
{
	Log(s:"MVLIFT floor ", d:Milli(GetSectorFloorZ(1, 0, 0)));
}

// Drive the platform explicitly rather than leaving it perpetual. A perpetual plat sits still on
// this map -- its only neighbouring floor is the room, so the low and high it derives leave it
// nowhere to travel -- and an explicit raise also makes the rising phase start on command instead
// of having to be caught. Speed 32 is 4 units per tic, well clear of the 8-unit JumpZ it adds to.
script 23 (void) net
{
	Floor_RaiseByValue(1, 32, 256);
	Log(s:"MVLIFT raising");
}

// +EDGEJUMP preserves upward velocity into a jump, so it needs a pawn that is `onground` AND
// already rising. Nothing in ZDoom's movement produces that: running up a slope moves the pawn
// positionally with velz staying 0 (measured -- see MASTERTEST.md), and a rising floor carries it
// without imparting velocity either. So the precondition is synthesised here. Run against the
// paired control class, the comparison still isolates the flag: whichever tic this lands on, both
// pawns get the same treatment, and only one of them is supposed to keep the velocity.
script 27 (int vz) net
{
	SetActorVelocity(0, GetActorVelX(0), GetActorVelY(0), vz * 65536, 0, 0);
	Log(s:"MVEDGE set velz ", d:vz);
}

// Hold a small upward velocity on GROUNDED tics only, so whichever tic the jump fires on it sees
// the pawn rising. Only while grounded: forcing it in the air would mask the jump entirely and
// make both classes look the same. Keep vz well under JumpZ so it cannot dominate the result --
// the edge-jump pawn should reach vz + JumpZ, the control just JumpZ.
script 28 (int tics, int vz) net
{
	int i;
	for (i = 0; i < tics; i++)
	{
		if (GetActorZ(0) <= GetActorFloorZ(0))
			SetActorVelocity(0, GetActorVelX(0), GetActorVelY(0), vz * 65536, 0, 0);
		Delay(1);
	}
	Log(s:"MVEDGE hold done");
}

// Effect actors are CLIENTSIDEONLY and spawned for the local player only -- the whole reason this
// port adds no recurring traffic. This runs SERVER-side, so a non-zero count here would mean they
// are being replicated after all, which is exactly the promise that must not silently break.
script 25 (void) net
{
	Log(s:"MVDUST server_count ", d:ThingCountName("MvDust", 0));
}

script 24 (void) net
{
	Floor_LowerByValue(1, 32, 256);
	Log(s:"MVLIFT lowering");
}
