{
  "about": "Named cameras that reproduce a specific rendering fault, so a check is a name rather than four numbers pasted from a screenshot. `fuactl shot <tag> --spot <name>` warps here and captures the GL/Vulkan pair.",
  "spots": {
    "dbab02-flatswap": {
      "map": "dbab02",
      "wad": "eoncollection_vol-1_b2.pk3,eonweapons_rc8.5t.pk3,zandrospree2rc2.pk3",
      "x": 87,
      "y": -1456,
      "z": -24,
      "angle": 134,
      "pitch": 10,
      "shows": "A lava floor in the fire corridor that renders as a completely different flat -- green foliage on orange -- in the Vulkan backend and correctly in GL. Reported as 'the triangulation isn't working and random textures get filled-in'; it is the animated-texture re-resolve repainting a batch that merged two different base textures.",
      "correct": "The floor is dark red lava with bright yellow veins, matching GL."
    },
    "dbab02-missinggrate": {
      "map": "dbab02",
      "wad": "eoncollection_vol-1_b2.pk3,eonweapons_rc8.5t.pk3,zandrospree2rc2.pk3",
      "x": 437,
      "y": -1063,
      "z": 16,
      "angle": 4,
      "pitch": 12,
      "shows": "A metal grate 3D floor spanning a lava pit. GL draws the grate and its side beams; Vulkan draws nothing at all and you see straight down to the lava. It comes and goes as the view turns, so it is a coverage problem, not a shading one.",
      "correct": "The grate and the beams between its top and bottom planes are present, as in GL."
    },
    "dbab01-glassfloor": {
      "map": "dbab01",
      "wad": "eoncollection_vol-1_b2.pk3,eonweapons_rc8.5t.pk3,zandrospree2rc2.pk3",
      "x": 700,
      "y": 192,
      "z": 120,
      "angle": 180,
      "pitch": 40,
      "shows": "Looking down into the lava pit at a translucent 3D floor. The grate reads as more solid in Vulkan than in GL.",
      "correct": "The lava beneath shows through at the same strength as GL, and a pickup lying on the floor sits on it rather than through it."
    },
    "dbab02-zfight": {
      "map": "dbab02",
      "wad": "eoncollection_vol-1_b2.pk3,eonweapons_rc8.5t.pk3,zandrospree2rc2.pk3",
      "x": 3,
      "y": -1256,
      "z": -24,
      "angle": 13,
      "pitch": 15,
      "shows": "Diagonal hatched z-fighting on the rock face ahead in the Vulkan backend, absent in GL. Reported as happening in many places, so it is likely a depth-precision or duplicate-geometry problem rather than one bad surface.",
      "correct": "The rock face is a single stable texture from every angle, as in GL."
    },
    "dbab02-3dfloortop": {
      "map": "dbab02",
      "wad": "eoncollection_vol-1_b2.pk3,eonweapons_rc8.5t.pk3,zandrospree2rc2.pk3",
      "x": 719,
      "y": -162,
      "z": 192,
      "angle": 76,
      "pitch": 10,
      "shows": "The walkable top surface of a 3D floor, missing in Vulkan so you see down into the pit below it. Regression from winding flats by the plane normal: a 3D floor's top surface is the control sector's CEILING plane, so its normal points down while the surface is seen from above.",
      "correct": "The dark 3D floor surface spans the room at the same height as in GL, hiding the pit below."
    },
    "bfg-stairs-slab": {
      "map": "MAP01",
      "x": -66,
      "y": 914,
      "z": 8,
      "angle": 89.4,
      "pitch": 0,
      "shows": "Fire a BFG straight ahead from here, then warp to (-64, 1150, 60) facing 90 and sweep the pitch. The mark lands on a platform's side face with the tread only eight units above its centre -- the join cuts through the MIDDLE of the mark, which an orthographic box projection cannot parameterise. It used to paint the middle of the scorch across the whole face of the box: a hard-edged black quad on the floor, reported as z-fighting."
    },
    "bfg-glow-on-floor": {
      "map": "MAP01",
      "x": -48.243,
      "y": 819.448,
      "z": 56,
      "angle": 50.0977,
      "pitch": 17.8418,
      "shows": "BFG at a column. The green glow (BFGLITE) appears detached on the floor well below the black scorch, which stops on the column. The glow's graphic is larger, so its blast radius reaches a floor the scorch's does not -- and nothing was measuring how far a surface is from where the blast actually landed, only whether it was inside the sphere."
    },
