#library "frefuse"
#include "zcommon.h"
#import "freflib.bcs"

// [Doruk-Aksoy] The second LOADACS library: it takes references to freflib's functions, keeps them in global variables and calls them on later maps.
// [Doruk-Aksoy] Each step runs as script 90N and, for scenarios/netacsfuncref.mjs, as its CLIENTSIDE copy 190N, which script 30000 starts on every client.

global int function( void )? 1:gRef;
global int function( void )? 2:gMapRef;

// [Doruk-Aksoy] MAP01: a reference taken here compares equal to freflib's own, and is kept for the next map.
void Map01Step( void ) {
   int function( void )? f = Seven;
   Log( s: "FREF same ", d: IsSeven( f ) );
   Log( s: "FREF call ", d: f() );
   gRef = Seven;
}

// [Doruk-Aksoy] MAP02, whose own BEHAVIOR loads first and moves every library's load position: the kept reference still calls and compares right.
void Map02Step( void ) {
   Log( s: "FREF stored ", d: gRef() );
   Log( s: "FREF storedsame ", d: IsSeven( gRef ) );
}

// [Doruk-Aksoy] MAP03, which never loads frefmap: calling a kept reference into it must stop this script, not run another module's function.
void Map03Step( void ) {
   Log( s: "FREF reached" );
   Log( s: "FREF unloaded ", d: gMapRef() );
}

script 901 ( void ) { Map01Step(); }
script 902 ( void ) { Map02Step(); }
script 903 ( void ) { Map03Step(); }
script 1901 ( void ) clientside { Map01Step(); }
script 1902 ( void ) clientside { Map02Step(); }
script 1903 ( void ) clientside { Map03Step(); }

// [Doruk-Aksoy] On the server, starts CLIENTSIDE script n on every client.
script 30000 ( int n ) { ACS_ExecuteAlways( n, 0 ); }
